// prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Tenancy ---

//
// A church. The tenant root.
//
// `id` is the UUID the console issues at signup - the same value every other
// Steward app stores for this church - so a church has one identity across the
// platform rather than one per app.
model Org {
  id        String   @id
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       Membership[]
  settings          AppSettings?
  invitations       Invitation[]
  studentCategories StudentCategory[]
  events            Event[]
  students          Student[]
  studentEvents     StudentEvent[]
  studentParents    StudentParent[]
  emergencyContacts StudentEmergencyContact[]
  teachers          Teacher[]
  studentTeachers   StudentTeacher[]
  attendances       Attendance[]
  payments          Payment[]
  auditLogs         AuditLog[]
  scheduleSessions  ScheduleSession[]

  @@index([slug])
}

//
// One person's place in one church.
//
// Role lives here rather than on `User` because a pooled deployment can hold
// the same person twice - a volunteer at two churches is one login and two
// roles. A role on `User` would be whichever church wrote last.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      UserRole @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([userId])
}

// --- Authentication ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Null for OAuth/magic-link users
  sessionVersion Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  invitations   Invitation[]
  memberships   Membership[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Invitation {
  id        String    @id @default(cuid())
  orgId     String
  org       Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email     String
  role      UserRole  @default(STAFF)
  token     String    @unique
  expiresAt DateTime
  invitedBy String
  inviter   User      @relation(fields: [invitedBy], references: [id])
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([orgId, email])
  @@index([token])
  @@index([expiresAt])
  @@index([orgId])
}

enum UserRole {
  ADMIN
  STAFF
  VIEWER
}

// --- Configuration & Settings ---

model AppSettings {
  id             String   @id @default(cuid())

  // One settings row per church. The singleton default this replaced is the
  // single most dangerous thing in a pooled database: every church would have
  // read, and overwritten, the same row.
  orgId          String   @unique
  org            Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  
  // Basic Branding
  siteName       String   @default("Steward · VBS")
  primaryColor   String   @default("#E8B847")
  secondaryColor String   @default("#C49A2E")
  logoUrl        String?
  
  // Church Information
  churchName     String?
  churchAddress  String?
  churchCity     String?
  churchState    String?
  churchZip      String?
  churchPhone    String?
  churchEmail    String?
  churchWebsite  String?
  
  // Additional Branding
  tagline        String?  // e.g., "Growing in Faith Together"
  welcomeMessage String?  // Custom welcome message for landing page
  footerText     String?  // Custom footer text
  
  // Social Media
  facebookUrl    String?
  instagramUrl   String?
  youtubeUrl     String?
  
  // Google Forms Integration
  googleFormsEnabled       Boolean  @default(false)
  googleFormsWebhookSecret String?  // Secret for validating incoming webhooks
  googleFormsUrl           String?  // URL of the registration form (for reference)
  googleFormsAutoApprove   Boolean  @default(false) // Auto-approve registrations
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model StudentCategory {
  id          Int      @id @default(autoincrement())
  orgId       String
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String?
  order       Int      @default(0)
  eventId     Int?
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  students    Student[]

  @@unique([eventId, name])
  @@index([eventId])
  @@index([orgId])
}

// --- Core Models ---

model Event {
  id        Int      @id @default(autoincrement())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  year      Int
  theme     String?
  isActive  Boolean  @default(false)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentEvents    StudentEvent[]
  attendances      Attendance[]
  payments         Payment[]
  sessions         ScheduleSession[]
  studentCategories StudentCategory[]

  @@unique([orgId, year])
  @@index([orgId, isActive])
}

model Student {
  id        Int      @id @default(autoincrement())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  size      String
  category  String
  categoryId Int?
  categoryRef StudentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  profileImageUrl String?
  profileImage    String?  @db.Text

  dateOfBirth     DateTime?
  grade           String?
  allergies       String?
  medicalNotes    String?
  photoConsent    Boolean   @default(false)
  notes           String?


  parentName      String?
  parentPhone     String?
  parentEmail     String?
  emergencyContact      String?
  emergencyPhone        String?
  emergencyRelationship String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events            StudentEvent[]
  attendances       Attendance[]
  payments          Payment[]
  parents           StudentParent[]
  emergencyContacts StudentEmergencyContact[]
  teachers          StudentTeacher[]

  @@index([orgId, name])
  @@index([categoryId])
  @@index([orgId])
}

model StudentEvent {
  id         Int      @id @default(autoincrement())
  orgId      String
  org        Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  Int
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId    Int
  enrolledAt DateTime @default(now())

  @@unique([studentId, eventId])
  @@index([studentId])
  @@index([eventId])
  @@index([orgId])
}

// --- Parent/Guardian (supports multiple) ---

model StudentParent {
  id            Int      @id @default(autoincrement())
  orgId         String
  org           Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId     Int
  name          String
  relationship  String?  // e.g., "Mother", "Father", "Guardian"
  phone         String?
  email         String?
  isPrimary     Boolean  @default(false)
  canPickup     Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([studentId])
  @@index([orgId])
}

// --- Emergency Contact (supports multiple) ---

model StudentEmergencyContact {
  id            Int      @id @default(autoincrement())
  orgId         String
  org           Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId     Int
  name          String
  relationship  String?
  phone         String
  altPhone      String?
  priority      Int      @default(1)  // 1 = primary, 2 = secondary, etc.
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([studentId])
  @@index([studentId, priority])
  @@index([orgId])
}

// --- Teachers/Volunteers ---

model Teacher {
  id            Int      @id @default(autoincrement())
  orgId         String
  org           Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name          String
  email         String?
  phone         String?
  bio           String?
  profileImageUrl String?  // Legacy URL field
  profileImage    String?  @db.Text // Base64 encoded image data
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  students      StudentTeacher[]

  @@index([orgId, isActive])
  @@index([orgId])
}

model StudentTeacher {
  id          Int      @id @default(autoincrement())
  orgId       String
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   Int
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId   Int
  role        String?  // e.g., "Primary", "Assistant", "Small Group Leader"
  assignedAt  DateTime @default(now())

  @@unique([studentId, teacherId])
  @@index([studentId])
  @@index([teacherId])
  @@index([orgId])
}

// --- Attendance & Payment ---

model Attendance {
  id        Int      @id @default(autoincrement())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId Int
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   Int
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([eventId, studentId, date])
  @@index([eventId, date])
  @@index([studentId])
  @@index([orgId])
}

model Payment {
  id        Int      @id @default(autoincrement())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId Int
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   Int
  amount    Decimal  @default(0) @db.Decimal(10, 2)
  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, studentId])
  @@index([studentId])
  @@index([orgId])
}

// --- Audit Log ---

model AuditLog {
  id           String   @id @default(cuid())
  orgId        String
  org          Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId       String
  action       String
  resourceType String?
  resourceId   String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([orgId, createdAt])
  @@index([orgId])
}

// --- Schedule Sessions ---

model ScheduleSession {
  id        Int      @id @default(autoincrement())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   Int
  title     String
  start     DateTime
  end       DateTime
  location  String?
  group     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, start])
  @@index([eventId, end])
  @@index([orgId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([userId])
}
