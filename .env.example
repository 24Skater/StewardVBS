NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=changeme

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vbsdb?schema=public

EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=postmaster@example.com
EMAIL_SERVER_PASSWORD=changeme
EMAIL_FROM="VBS App <no-reply@example.com>"

WEBHOOK_SECRET=changeme-webhook

# Redis password (REQUIRED in production — leave empty for local dev with docker-compose.yml)
# In production: use a strong random password (e.g., openssl rand -base64 32)
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# --- Hosted platform (all optional) ---
#
# Leave every one of these unset to run VBS standalone. That is a supported
# deployment, not a degraded one: with no console configured the app resolves
# its single church itself and every entitlement check passes, exactly as it
# behaved before the platform existed.
#
# Set them only when this VBS is being run as part of hosted Steward.

# Where tenant hosts live. Set this and a church is resolved from the hostname
# ({slug}-stewardvbs.app.<root>); leave it unset and the sole church in the
# database is used. Include the port in local development — the Host header
# carries one, so a root without it matches nothing.
# PLATFORM_ROOT_DOMAIN=stewardgrace.com

# This app's own service token, used to authenticate the console's calls to
# /api/internal/provision and this app's calls to the console. One per app on
# purpose: a token leaked from another Steward app cannot be used here.
# PLATFORM_SERVICE_TOKEN=stw_svc_vbs_changeme

# The console, for fetching entitlements. Without it no entitlement is ever
# checked and the app is unmetered.
# PLATFORM_CONSOLE_URL=https://app.stewardgrace.com

# --- Object storage for profile photos (all optional) ---
#
# Unset, photos are stored inline as base64 data URIs exactly as they always
# were, and a self-hosted install needs no extra service. Set, photos go to any
# S3-compatible store under a key prefixed with the church's id, which is what
# keeps hundreds of gigabytes of image data out of a database shared by a
# thousand churches.
#
# Works with MinIO, Cloudflare R2, Backblaze B2 or AWS S3. docker-compose.yml
# ships a MinIO service under the `storage` profile:
#
#   docker compose --profile storage up -d
#
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_ACCESS_KEY_ID=minioadmin
# STORAGE_SECRET_ACCESS_KEY=minioadmin
# STORAGE_BUCKET=vbs-uploads
# STORAGE_REGION=auto

# ---------------------------------------------------------------------------
# Single sign-on (optional)
# ---------------------------------------------------------------------------
#
# One identity provider across the Steward applications, so somebody who uses
# Congregation and VBS signs in once rather than twice.
#
# Unset, the provider is not registered, the sign-in page does not mention it,
# and Google, Microsoft, the magic link and email-and-password all work exactly
# as before. A church running VBS on its own server never needs any of it.
#
# Create a Regular Web Application at the identity provider and set its
# callback URL to <your-url>/api/auth/callback/auth0
#
# AUTH0_ISSUER=https://your-tenant.us.auth0.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
#
# What the sign-in button says.
# AUTH0_BUTTON_LABEL=Continue with Steward ID
#
# Email-and-password sign-in. Defaults to on, and the password column is never
# dropped. Set to "false" only once single sign-on is proven for everybody who
# needs to get in - it is a deliberate act, not a default.
# ALLOW_LOCAL_PASSWORD_LOGIN=true
